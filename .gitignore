.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.venv/

# prototype/ is its own separate git repo (github.com/trigger-nav/stingray-demo)
prototype/

# binary duplicates of tracked markdown docs
*.docx
docs_assets_system_overview.png

# ingest download/extract cache (large raw source data; only the small
# cropped outputs under data/ get committed)
.cache/

# fetched weather forecasts (ticket 0.5): unlike data/geography's static,
# committed data, these go stale within hours -- regenerable, per-run
# artefacts, not repo content. Run ingest/fetch_grib_nomads.py /
# fetch_grib_ecmwf.py to produce them locally.
data/weather/*.npz

# ticket B7: per-track-driven-region geography/weather/annotated-track
# data (data/historical/README.md has the convention) -- real historical
# vessel data is ticket B6's job, never committed here; keep the README
# itself tracked.
data/historical/*/

# ticket R1: same staleness reasoning as data/weather/*.npz above,
# extended to any region pack's own weather npz
# (data/region_packs/<pack>/weather_*.npz) -- geography (GEBCO/GSHHG) and
# ports are static and stay committed per-pack; weather doesn't.
# tests/test_uk_sw_pack_acceptance.py skips (doesn't fail) when this file
# is absent -- run docs/region-pack-runbook.md's weather step to
# regenerate it locally.
data/region_packs/*/weather_*.npz

# ticket C1: the intermediate CMEMS currents-only npz
# (data/region_packs/<pack>/currents_<pack>.npz, ingest/fetch_currents_cmems.py)
# is merged into weather_*.npz above and not itself a source of truth --
# same staleness reasoning, regenerate via docs/region-pack-runbook.md §6.
data/region_packs/*/currents_*.npz
