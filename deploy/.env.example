# Stingray planner/capture service configuration (ticket B1/B5).
# Copy to .env (or set these as real environment variables / systemd
# EnvironmentFile / Windows service environment) -- never commit a real
# .env with real credentials.

# cloud | vessel -- the one flag that makes the identical binary behave
# correctly on either deployment target (contract point 2). See
# api/config.py and CLAUDE.md's STINGRAY_ROLE gotcha.
STINGRAY_ROLE=vessel

STINGRAY_HOST=127.0.0.1
STINGRAY_PORT=8000

# HTTP Basic Auth -- a single shared credential pair (design 9, a stopgap,
# not tenancy). Set both to real, non-default values before deploying --
# this MUST match prototype/stingray_planner.html's API_AUTH constant for
# the hosted demo to authenticate against a cloud-role instance.
STINGRAY_API_USER=changeme
STINGRAY_API_PASSWORD=changeme

# cloud role, public demo (ticket B2): the exact browser origin(s) allowed
# to call this API cross-origin (api/main.py's CORSMiddleware) -- comma-
# separated if more than one. Get this wrong and the browser silently
# blocks every request with no server-side error to grep for (CORS
# preflight failures don't reach application code at all). Defaults to
# http://localhost:8080 (local dev only) if unset -- a real cloud
# deployment must set this explicitly. Not needed on a vessel-role
# instance (LAN/localhost-only, no browser-origin concept applies).
STINGRAY_CORS_ORIGINS=https://trigger-nav.github.io

# Data paths -- defaults match the committed repo layout; override for a
# packaged install where `data/` lives next to the binary.
STINGRAY_VESSEL_SPEC_PATH=data/vessel_specs/mys_50m_default.yaml
STINGRAY_WEATHER_NPZ_PATH=data/weather/ecmwf_western_med.npz
STINGRAY_TELEMETRY_DB_PATH=data/telemetry/telemetry.sqlite3
# Geography defaults (GSHHG coastline/GEBCO bathymetry crop, no-go/TSS
# zones) rarely need overriding -- uncomment only to point at a different
# region pack (ROADMAP.md's R1/R2).
# STINGRAY_COASTLINE_PATH=data/geography/coastline_western_med.json
# STINGRAY_BATHYMETRY_PATH=data/geography/bathymetry_western_med.npz
# STINGRAY_NOGO_PATH=data/geography/nogo_western_med.json
# STINGRAY_TSS_PATH=data/geography/tss_western_med.json

# vessel-role only: the cloud instance to pull compact weather npz from
# (design 6). Leave unset on a cloud-role instance.
STINGRAY_CLOUD_WEATHER_URL=https://your-cloud-instance.example.com

# Worker pool size -- default (unset) uses os.cpu_count().
# STINGRAY_POOL_SIZE=4

# Job-queue tuning (api/jobs.py) -- sane defaults for a small single-VM
# deployment, rarely need changing. max_queue_depth caps concurrent
# queued+running jobs (429+Retry-After once exceeded, ticket B2
# amendment); the job_* settings bound the in-memory job-record dict's
# growth over a long-running process (TTL + hard size backstop).
# STINGRAY_MAX_QUEUE_DEPTH=20
# STINGRAY_JOB_TTL_S=86400
# STINGRAY_JOB_MAX_SIZE=5000
# STINGRAY_JOB_EVICTION_INTERVAL_S=300
